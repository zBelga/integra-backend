# ═══════════════════════════════════════════════════════════════
#  SISTEMA ÍNTEGRA — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie para .env e preencha. NUNCA versione o .env.

# ─── BACKEND (Railway) ─────────────────────────────────────────

# Segredo do JWT — gere um novo para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta — o Railway injeta automaticamente, não precisa definir lá
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Modo API-ONLY: true = backend não serve o frontend (deploy separado)
# Em produção é ativado automaticamente quando NODE_ENV=production
API_ONLY=false

# Origens liberadas no CORS (separadas por vírgula, sem barra no final).
# Aceita wildcard de subdomínio: https://*.vercel.app
# Localhost é liberado automaticamente em dev.
CORS_ORIGINS=https://seu-projeto.vercel.app,https://*.vercel.app

# Diretório do banco SQLite.
# IMPORTANTE no Railway: aponte para o mount point de um Volume (ex.: /data),
# senão os dados são perdidos em cada deploy (disco efêmero).
DATABASE_DIR=

# ─── SUPABASE (Storage dos documentos) ──────────────────────────
SUPABASE_URL=https://lovuerrdvvzehzkpjmdj.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta — só no backend, NUNCA no frontend
SUPABASE_SERVICE_ROLE_KEY=

# ─── GEMINI AI (opcional) ───────────────────────────────────────
GEMINI_API_KEY=

# ─── FRONTEND (Vercel) ──────────────────────────────────────────
# Variáveis com prefixo VITE_ são embutidas no bundle do navegador.
# NUNCA coloque chaves secretas aqui.

# URL pública do backend no Railway (sem barra no final).
# Em dev deixe vazio para usar o proxy do Vite.
VITE_API_URL=

# URL do app (para links e metadados)
APP_URL=http://localhost:3000
